# ─────────────────────────────────────────────────────────
# Portfolio Backend — Environment Variables
# Copy this file to .env and fill in your real values.
# ─────────────────────────────────────────────────────────

PORT=5000

# SMTP credentials (Gmail example)
# For Gmail: enable 2-Step Verification → generate an App Password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_gmail_address@gmail.com
SMTP_PASS=your_16_char_app_password

# The inbox that receives contact form submissions
RECEIVER_EMAIL=your_gmail_address@gmail.com
